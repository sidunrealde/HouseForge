# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# Local Python environment for the drawing generator (Scripts/gen_sample_drawings.py).
# Created on first run so nothing is installed globally; never committed.
Scripts/.venv/
Scripts/__pycache__/

# Drawing sets an artist imports through the DRAWINGS panel.
#
# Reference/Drawings is where the panel copies imported sheets to, and it is also where the
# plugin's own reference set lives - so every artist who used the panel dirtied the plugin repo
# with their client's floor plans, and the validation gate refused to merge until they were dealt
# with. Their drawings are their work, not the plugin's.
#
# Tracked sets are unaffected: git ignores nothing it already tracks, so Sample2BHK stays in.
# Adding a new reference set on purpose takes `git add -f`, which is the right amount of friction
# for a decision that ships someone's floor plan to a public repo.
Reference/Drawings/*/
!Reference/Drawings/Sample2BHK/

# Specs generated from an artist's own drawings.
#
# Reference/Specs holds the plugin's own reference spec AND is where SaveSpec writes, so a
# generation leaves someone's flat in the plugin's repo. Same reasoning as the drawings above:
# their spec is their work. Sample2BHK.json is tracked and so is unaffected; a new reference spec
# takes `git add -f`.
Reference/Specs/*.json
!Reference/Specs/Sample2BHK.json
